\contentsline {figure}{\numberline {6}{\ignorespaces Peta Tren Spasial Perubahan Iklim Presipitasi 25 Tahun (2001--2025) Menggunakan Estimator Sen's Slope (mm/tahun per piksel 250m).}}{12}{figure.caption.15}%
